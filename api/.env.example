DATABASE_URL="postgresql://postgres:postgres@localhost:5432/villa_listing?schema=public"
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN_SECONDS=604800
CORS_ORIGIN="http://localhost:3000"
# WhatsApp number in international format, digits only (country code + number, no "+" or leading 0)
WHATSAPP_NUMBER="905000000000"
# Used only if the live FX API is unreachable: how many TRY one unit of the currency costs
FALLBACK_RATES_TRY_PER_UNIT='{"USD":42,"EUR":49,"GBP":56}'
# Optional seed credentials (defaults shown)
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="Admin123!"
# SEED_USER_EMAIL="user@example.com"
# SEED_USER_PASSWORD="User123!"
# Public URL of the Next.js site, used to add the villa link to WhatsApp messages
PUBLIC_WEB_URL="http://localhost:3000"
